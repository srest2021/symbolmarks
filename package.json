{
  "name": "symbolmarks",
  "displayName": "symbolmarks",
  "description": "Symbol bookmarks",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "symbolmarks",
          "title": "Symbolmarks",
          "icon": "media/bookmark.svg"
        }
      ]
    },
    "views": {
      "symbolmarks": [
        {
          "id": "symbolmarks.view",
          "name": "Bookmarks"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "symbolmarks.view",
        "contents": "No bookmarks yet.\nPlace your cursor on a symbol or line and run Bookmark Symbol (⌘⌥K)."
      }
    ],
    "commands": [
      {
        "command": "symbolmarks.bookmark",
        "title": "Bookmark Symbol",
        "category": "Symbolmarks"
      },
      {
        "command": "symbolmarks.jump",
        "title": "Jump to Bookmark",
        "category": "Symbolmarks"
      },
      {
        "command": "symbolmarks.remove",
        "title": "Remove Bookmark",
        "category": "Symbolmarks",
        "icon": "$(trash)"
      },
      {
        "command": "symbolmarks.rename",
        "title": "Rename Bookmark",
        "category": "Symbolmarks",
        "icon": "$(edit)"
      },
      {
        "command": "symbolmarks.toggleSort",
        "title": "Toggle Sort Order",
        "category": "Symbolmarks",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "symbolmarks.clearAll",
        "title": "Clear All Bookmarks",
        "category": "Symbolmarks"
      },
      {
        "command": "symbolmarks.newGroup",
        "title": "New Folder",
        "category": "Symbolmarks",
        "icon": "$(new-folder)"
      },
      {
        "command": "symbolmarks.newSubgroup",
        "title": "New Subfolder",
        "category": "Symbolmarks",
        "icon": "$(new-folder)"
      },
      {
        "command": "symbolmarks.renameGroup",
        "title": "Rename Folder",
        "category": "Symbolmarks",
        "icon": "$(edit)"
      },
      {
        "command": "symbolmarks.deleteGroup",
        "title": "Delete Folder",
        "category": "Symbolmarks",
        "icon": "$(trash)"
      },
      {
        "command": "symbolmarks.moveUp",
        "title": "Move Up",
        "category": "Symbolmarks",
        "icon": "$(arrow-up)"
      },
      {
        "command": "symbolmarks.moveDown",
        "title": "Move Down",
        "category": "Symbolmarks",
        "icon": "$(arrow-down)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "symbolmarks.jump",
          "when": "false"
        },
        {
          "command": "symbolmarks.remove",
          "when": "false"
        },
        {
          "command": "symbolmarks.rename",
          "when": "false"
        },
        {
          "command": "symbolmarks.newSubgroup",
          "when": "false"
        },
        {
          "command": "symbolmarks.renameGroup",
          "when": "false"
        },
        {
          "command": "symbolmarks.deleteGroup",
          "when": "false"
        },
        {
          "command": "symbolmarks.moveUp",
          "when": "false"
        },
        {
          "command": "symbolmarks.moveDown",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "symbolmarks.bookmark",
          "when": "editorTextFocus",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "symbolmarks.newGroup",
          "when": "view == symbolmarks.view",
          "group": "navigation@0"
        },
        {
          "command": "symbolmarks.toggleSort",
          "when": "view == symbolmarks.view",
          "group": "navigation@1"
        },
        {
          "command": "symbolmarks.clearAll",
          "when": "view == symbolmarks.view",
          "group": "1_actions"
        }
      ],
      "view/item/context": [
        {
          "command": "symbolmarks.newSubgroup",
          "when": "view == symbolmarks.view && viewItem == group.nestable",
          "group": "inline@1"
        },
        {
          "command": "symbolmarks.renameGroup",
          "when": "view == symbolmarks.view && viewItem =~ /^group/",
          "group": "inline@2"
        },
        {
          "command": "symbolmarks.deleteGroup",
          "when": "view == symbolmarks.view && viewItem =~ /^group/",
          "group": "inline@3"
        },
        {
          "command": "symbolmarks.rename",
          "when": "view == symbolmarks.view && viewItem == symbolmark",
          "group": "inline@1"
        },
        {
          "command": "symbolmarks.remove",
          "when": "view == symbolmarks.view && viewItem == symbolmark",
          "group": "inline@2"
        },
        {
          "command": "symbolmarks.moveUp",
          "when": "view == symbolmarks.view",
          "group": "2_move@1"
        },
        {
          "command": "symbolmarks.moveDown",
          "when": "view == symbolmarks.view",
          "group": "2_move@2"
        }
      ]
    },
    "configuration": {
      "title": "Symbolmarks",
      "properties": {
        "symbolmarks.maxGroupDepth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Maximum number of nested folder levels."
        }
      }
    },
    "keybindings": [
      {
        "command": "symbolmarks.bookmark",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "symbolmarks.moveUp",
        "key": "alt+up",
        "mac": "cmd+up",
        "when": "focusedView == symbolmarks.view"
      },
      {
        "command": "symbolmarks.moveDown",
        "key": "alt+down",
        "mac": "cmd+down",
        "when": "focusedView == symbolmarks.view"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
